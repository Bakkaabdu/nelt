<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- CA1848 (LoggerMessage delegates) and CA2007 (ConfigureAwait) are noise for an ASP.NET Core app. -->
    <NoWarn>$(NoWarn);CA1000;CA1848;CA2007;CA1716;CA1819;CA1002;CA2227;CA1056;CA1054;CA1055;CA1308;CA1305;CA1304;CA1311;CA1031;CA1062;CA1515;CA1711;CA1724;CA1707;CA1822;CA1859;CA1860;CA1862;CA1873;CA2234;CA1034;CA1051;CA1024</NoWarn>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
