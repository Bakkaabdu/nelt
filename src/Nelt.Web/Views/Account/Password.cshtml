@model AccountFormModel<ChangePasswordInput>
@{ ViewData["Title"] = L["Change password"]; }
<section class="auth container">
    <div class="auth__card">
        <span class="tricolor tricolor--short" aria-hidden="true"><span></span><span></span><span></span></span>
        <h1>@L["Change password"]</h1>
        <form method="post" asp-action="Password" class="form" style="margin-top:24px">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <field asp-for="Input.CurrentPassword" autocomplete="current-password" />
            <field asp-for="Input.NewPassword" autocomplete="new-password" />
            <field asp-for="Input.ConfirmPassword" autocomplete="new-password" />
            <button type="submit" class="btn btn--primary btn--lg btn--block">@L["Save new password"]</button>
        </form>
        <p class="auth__alt"><a class="link" href="@DashboardUrl()">@L["Back to my dashboard"]</a></p>
    </div>
</section>
