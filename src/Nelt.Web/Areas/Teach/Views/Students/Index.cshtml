@model CourseRoster
@{ ViewData["Title"] = L["Students & progress"]; var id = Model.Course.Id; }
<partial name="_CourseTabs" model="Model.Course" />
<p class="muted" style="margin:-8px 0 16px">@L["Where every student is in the course, how they perform, and whether they are on track for the certificate and the next level."]</p>
@if (Model.Rows.Count == 0)
{
    <div class="card empty"><icon name="users" /><p class="empty__title">@L["No active students yet."]</p></div>
}
else
{
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>@L["Student"]</th>
                    <th>@L["Progress"]</th>
                    <th class="hide-sm">@L["Current lesson"]</th>
                    <th class="num hide-sm">@L["Quizzes"]</th>
                    <th class="num hide-sm">@L["Assignments"]</th>
                    <th class="num hide-sm">@L["Attendance"]</th>
                    <th class="num hide-sm">@L["Final exam"]</th>
                    <th class="num">@L["Overall"]</th>
                    <th>@L["Outlook"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    var p = r.Performance;
                    var e = r.Evaluation;
                    <tr>
                        <td>
                            <a class="cell-title" asp-action="Show" asp-route-courseId="@id" asp-route-enrollmentId="@r.EnrollmentId">@r.StudentName</a>
                            <div class="cell-sub">@Label(r.Mode)@(r.LastActivityAt is { } last ? " · " + L["active {0}", Date(last)] : null)</div>
                        </td>
                        <td style="min-width:140px">
                            <div class="progress-label"><span>@p.LessonsCompleted/@p.LessonsTotal</span><span>@((int)p.LessonCompletion)%</span></div>
                            <div class="progress" style="--p:@((int)p.LessonCompletion)%"></div>
                        </td>
                        <td class="hide-sm small">@(r.CurrentLesson ?? "—")</td>
                        <td class="num hide-sm">@Percent(p.QuizAverage)</td>
                        <td class="num hide-sm">@p.AssignmentsSubmitted/@p.AssignmentsTotal</td>
                        <td class="num hide-sm">@(r.Mode == StudyMode.InPerson ? Percent(p.AttendanceRate) : "—")</td>
                        <td class="num hide-sm">@Percent(p.FinalExamScore)</td>
                        <td class="num"><strong>@Percent(e.OverallScore)</strong></td>
                        <td>
                            @if (r.Status == EnrollmentStatus.Completed) { <span class="badge badge--success">@L["Completed"]</span> }
                            else if (e.IsNextLevelEligible) { <span class="badge badge--success">@L["Next level"]</span> }
                            else if (e.IsCertificateEligible) { <span class="badge badge--info">@L["Passing"]</span> }
                            else if (e.IsProvisional) { <span class="badge badge--plain">@L["In progress"]</span> }
                            else { <span class="badge badge--danger">@L["At risk"]</span> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
